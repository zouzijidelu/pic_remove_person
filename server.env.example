# 复制为 server.env 后由 start.sh / systemd 自动加载
HOST=0.0.0.0
PORT=7860
INBROWSER=0
LAMA_DEVICE=cuda
SAM_DEVICE=cuda
ENABLE_POWERPAINT=0
POWERPAINT_DEVICE=cuda
POWERPAINT_MAX_SIDE=768
IOPAINT_BENCH=/root/iopaint-bench
ENABLE_QWEN_EDIT=0
QWEN_EDIT_DEVICE=cuda
QWEN_EDIT_MAX_SIDE=768
QWEN_EDIT_MARGIN=256
QWEN_EDIT_BENCH=/root/qwen-edit-bench
QWEN_EDIT_PROMPT=Remove the person. Reconstruct the background only. Do not add new people.
# 本机无 GPU 时设 1，只走 JSON 协议、不加载权重
QWEN_EDIT_DRY_RUN=0
MAX_INFER_SIDE=2048
PREVIEW_MAX_SIDE=960
HF_ENDPOINT=https://hf-mirror.com
# 启动时预下载/加载 SAM、LaMa、PowerPaint；Qwen 默认不预热（3090 显存互斥）
WARMUP=1
WARMUP_QWEN=0
# 可选：界面登录，格式 user:password
# GRADIO_AUTH=admin:change-me
