# 复制为 server.env 后由 start.sh / systemd 自动加载
HOST=0.0.0.0
PORT=7860
INBROWSER=0
LAMA_DEVICE=cuda
SAM_DEVICE=cuda
ENABLE_POWERPAINT=0
POWERPAINT_DEVICE=cuda
POWERPAINT_MAX_SIDE=768
IOPAINT_BENCH=/root/iopaint-bench
MAX_INFER_SIDE=2048
PREVIEW_MAX_SIDE=960
HF_ENDPOINT=https://hf-mirror.com
# 启动时预下载/加载 SAM、LaMa、PowerPaint；本机调试可改 0
WARMUP=1
# 可选：界面登录，格式 user:password
# GRADIO_AUTH=admin:change-me
